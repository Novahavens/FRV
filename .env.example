# ── Supabase ───────────────────────────────────────────────────────────────
# Project settings → API. The service role key is server-only.
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# ── Listing lookup ─────────────────────────────────────────────────────────
# Firecrawl's catalogued Zillow capability fills rent, beds, baths, sqft and
# coordinates from a listing URL the account manager has already chosen.
# Leave the key empty and the form falls back to manual entry.
FIRECRAWL_API_KEY=

# ── Address autocomplete (optional) ────────────────────────────────────────
# Public, client-side key for Google Places suggestions on the loss address.
# Enable "Places API (New)" and restrict the key by HTTP referrer. Leave empty
# and the field is a plain input with US Census geocoding on blur.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# ── Report imagery (optional) ──────────────────────────────────────────────
# Server-only key for the Street View photo and the hybrid map on the report.
# Enable "Maps Static API" and "Street View Static API". Restrict the key by
# API, NOT by HTTP referrer (requests come from our server, not a browser).
# Never prefix it NEXT_PUBLIC_. Leave empty and the report shows the house
# placeholder and no map.
GOOGLE_MAPS_SERVER_KEY=
