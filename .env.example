# ── Supabase ───────────────────────────────────────────────────────────────
# Project settings → API. The service role key is server-only.
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# ── Listing lookup ─────────────────────────────────────────────────────────
# Firecrawl's catalogued Zillow capability fills rent, beds, baths, sqft and
# coordinates from a listing URL the account manager has already chosen.
# Leave the key empty and the form falls back to manual entry.
FIRECRAWL_API_KEY=
